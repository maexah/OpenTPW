#!/bin/sh
# The hook everyone runs. It refuses a commit that stages a file of the game's (tools/content_guard.py: the disc's
# file names and types, save/, a saved park, a disc image, content/ReferenceScreenshots/). Needs python3.
# Enable once per clone: git config core.hooksPath tools/hooks
# The maintainer's clone also has `git config opentpw.maintainer true`, which adds tools/maintainer/hooks/pre-commit
# (the queue and status sweeps); nobody else needs it.
root=$(git rev-parse --show-toplevel) || exit 1
if command -v python3 >/dev/null 2>&1; then
	python3 "$root/tools/content_guard.py" staged || exit 1
elif command -v python >/dev/null 2>&1; then
	python "$root/tools/content_guard.py" staged || exit 1
else
	echo "content guard: no python3 on PATH, so the staged files were not checked (tools/content_guard.py staged)" >&2
fi
if [ "$(git config --get opentpw.maintainer)" = "true" ] && [ -x "$root/tools/maintainer/hooks/pre-commit" ]; then
	"$root/tools/maintainer/hooks/pre-commit" "$@" || exit 1
fi
exit 0
