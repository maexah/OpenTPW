#!/bin/sh
# Does nothing for a contributor. In the maintainer's clone (`git config opentpw.maintainer true`) it hands the push
# to tools/maintainer/hooks/pre-push, which republishes the fan website when main is pushed. Enable once per clone:
# git config core.hooksPath tools/hooks
root=$(git rev-parse --show-toplevel) || exit 0
if [ "$(git config --get opentpw.maintainer)" = "true" ] && [ -x "$root/tools/maintainer/hooks/pre-push" ]; then
	exec "$root/tools/maintainer/hooks/pre-push" "$@"
fi
exit 0
