<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<LangVersion>14.0</LangVersion>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Formats\Model\**" />
	  <EmbeddedResource Remove="Formats\Model\**" />
	  <None Remove="Formats\Model\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="icon.ico" />
	</ItemGroup>

	<!--
		The engine's own files travel with the binary: the shaders it compiles as it starts, and the one font
		the loading screen writes with. They keep their "content\..." layout in the output, which is the
		spelling the code uses, and ContentDir finds them there rather than in whatever directory the game
		happened to be started from.

		Deliberately narrow, and note that anything left in content\shaders ships. content\textures,
		content\icons and the disc image beside them are read by no code at all, and the disc image on its own
		is half a gigabyte.
	-->
	<ItemGroup>
		<Content Include="..\..\content\shaders\**\*" LinkBase="content\shaders">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\..\content\fonts\Roboto-Medium.ttf" Link="content\fonts\Roboto-Medium.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ImGui.NET" Version="1.87.2" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<!--
			Decodes the MPEG Layer I and Layer II streams inside a .sdt - see AudioClip. Pin 3.0.0
			or newer: 1.16.0 decodes Layer I correctly but gets MPEG-2 Layer II wrong, which is
			every piece of music in the game. 3.0.0 is sample-exact against ffmpeg on a spread of
			99 streams covering all five encodings the game ships, give or take a rounding step in
			the last bit.
		-->
		<PackageReference Include="NLayer" Version="3.0.0" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<PackageReference Include="StbImageSharp" Version="2.27.8" />
		<PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.0" />
		<PackageReference Include="Veldrid" Version="4.9.0" />
		<PackageReference Include="Veldrid.ImGui" Version="5.72.0" />
		<PackageReference Include="Veldrid.SDL2" Version="4.8.0" />
		<PackageReference Include="Veldrid.SPIRV" Version="1.0.14" />
		<PackageReference Include="Veldrid.StartupUtilities" Version="4.8.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\OpenTPW.Common\OpenTPW.Common.csproj" />
	  <ProjectReference Include="..\OpenTPW.Files\OpenTPW.Files.csproj" />
	  <ProjectReference Include="..\OpenTPW.ModKit\OpenTPW.ModKit.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>

</Project>
